# Run products. Every one of these is regenerated by a script in code/, so committing them would
# let a stale result outlive the code that made it. Patterns are anchored with a leading slash or
# an explicit prefix, because a bare `figures/` also matches code/figures/, which is source.
__pycache__/
*.pyc
/figures/
code/*/figures/
code/analysis/*.json
code/analysis/*.tex
code/diagnostics/*.json
code/rag_variants/*.json
